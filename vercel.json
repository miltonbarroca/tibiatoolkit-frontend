{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/stats/script.js",
      "destination": "https://tibia-toolkit-production.up.railway.app/stats/script.js"
    },
    {
      "source": "/api/send",
      "destination": "https://tibia-toolkit-production.up.railway.app/api/send"
    },
    {
      "source": "/documentacao",
      "destination": "https://tibia-toolkit-production.up.railway.app/documentacao"
    },
    {
      "source": "/termos",
      "destination": "https://tibia-toolkit-production.up.railway.app/termos"
    },
    {
      "source": "/privacidade",
      "destination": "https://tibia-toolkit-production.up.railway.app/privacidade"
    },
    {
      "source": "/static/:path*",
      "destination": "https://tibia-toolkit-production.up.railway.app/static/:path*"
    }
  ]
}
